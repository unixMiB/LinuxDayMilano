---
import Container from "react-bootstrap/Container";

import ear from "@assets/ear-piece.svg";

import Envelope from "~icons/fa6-solid/envelope";
import Globe from "~icons/fa6-solid/globe";
import MapMarketAlt from "~icons/fa6-solid/map-location-dot";
import ChevronRight from "~icons/fa6-solid/chevron-right";

import { default as data } from "@assets/siteMetadata.yml";
import { Image } from "astro:assets";
---

<footer>
  <section id='contattaci'>
    <Container className='footer'>
      <div class='d-flex justify-content-start gx-md-5'>
        <div
          style={{ overflow: "hidden", height: "20rem" }}
          class='d-md-block d-none'
        >
          <Image
            alt=''
            height='400'
            width='382'
            class=''
            role='presentation'
            src={ear}
          />
        </div>
        <div class='my-5'>
          <Container>
            <h3>Contatta l'organizzazione</h3>
            <ul>
              <li title='Indirizzo di posta'>
                <Envelope />{" "}
                <a href={"mailto:" + data.contacts.email}>
                  {data.contacts.email}
                </a>
              </li>
              <li title='Sito web'>
                <Globe />{" "}
                <a href={data.contacts.website} title='Sito web'>
                  {data.contacts.website}
                </a>
              </li>
              <li title="Luogo dell'evento">
                <MapMarketAlt />{" "}
                {data.contacts.place.name}
              </li>
              <li title="Luogo dell'evento">
                <ChevronRight />{" "}
                {data.contacts.place.street}
              </li>
              <li title="Luogo dell'evento">
                <ChevronRight />{" "}
                {data.contacts.place.building}
              </li>
              <li title="Luogo dell'evento">
                <ChevronRight />{" "}
                {data.contacts.place.cap}
              </li>
            </ul>
          </Container>
        </div>
      </div>
    </Container>
  </section>
  <section class='section-license text-center align align-middle'>
    Quest'opera è distribuita con Licenza Creative Commons Attribuzione -{" "}
    <span class='ldmi'> Condividi allo stesso modo 4.0 Internazionale </span>
    {" - "}
    ILS Milano <span class='ldmi'>{new Date().getFullYear()}</span>
  </section>
</footer>
