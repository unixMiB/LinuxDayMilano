---
import Button from "react-bootstrap/Button";
import Alert from "react-bootstrap/Alert";
import Container from "react-bootstrap/Container";

import Calendar from "~icons/fa6-solid/calendar";
import Clock from "~icons/fa6-solid/clock";
import MapMarketAlt from "~icons/fa6-solid/map-location-dot";
import ChevronRight from "~icons/fa6-solid/chevron-right";
import CircleInfo from "~icons/fa6-solid/circle-info";

import { default as siteMetadata } from "@assets/siteMetadata.yml";
import Location from "@assets/images/politecnico.jpg";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

const allSchedulesYaml = await getCollection("schedules");

const { small } = Astro.props;

const previousYear = allSchedulesYaml.map((node) => node.data.year)[1];
const params = siteMetadata.switches.schedule
  ? ""
  : "?" + new URLSearchParams({ year: previousYear });
---

<div
  style={{
    position: "relative",
    color: "black",
  }}
>
  <Picture
    style={{
      filter: "brightness(0.4)",
      position: "absolute",
      top: 0,
      left: 0,
      width: "100%",
      height: "100%",
      zIndex: -1,
      overflow: "hidden",
      objectFit: "cover",
      objectPosition: "bottom",
      maxWidth: "none",
    }}
    src={Location}
    layout='fixed'
    widths={[240, 320, 480, 540, 640, 720, 960, 1280, 1600, 1920, 2560, 3840]}
    sizes='100vw'
    loading='eager'
    alt=''
    aria-hidden='true'
  />

  <div
    style={{
      position: "relative",
      zIndex: 1,
    }}
  >
    <Container className='hero'>
      <Alert variant='danger'>
        <Alert.Heading>
          <CircleInfo className='me-3' />
          Comunicazione urgente sulle modalità di accesso al Linux Day 2026
        </Alert.Heading>
        <hr />
        <p>
          Gentilissimi,<br />
          <br />
          Per ragioni attribuibili ai possibili disordini nella giornata del 24 ottobre
          2026 e quindi non imputabili al comitato organizzativo del Linux Day 2026,
          la direzione del Politecnico di Milano ha richiesto al comitato di contingentare
          gli ingressi durante l'intero svolgimento dell'evento. Per adempiere a
          questa richiesta, chiediamo gentilmente a tutti gli speaker, sponsor, espositori
          e a tutte le persone che intendono visitare l'evento di registrarsi e scaricare
          il ticket al seguente link:<br /><br />
          <a href='https://tickets.poul.org/LD/2026/' target='_blank' rel='noopener noreferrer'>
            https://tickets.poul.org/LD/2026/
          </a>
          <br /><br />
          Inoltre, l'unico ingresso disponibile
          sarà quello in Via Andrea Maria Ampère 2.<br />
          Ci scusiamo enormemente per il disagio e speriamo di vedervi all'evento.<br
          /><br />
          Comitato organizzativo del Linux Day Milano<br />
          unixMiB, POuL e ILS.
        </p>
      </Alert>
      <h1 style={{ textTransform: "uppercase" }} class='mb-0 title'>
        Linux Day Milano
        <span class='ldmi'>{siteMetadata.event.date.getFullYear()}</span>
      </h1>
      <h4 class='pb-3 pb-sm-5 title'>
        <small>
          organizzato da
          <a
            title='Scopri di più su POuL'
            href={siteMetadata.contacts.website}
            target='_blank'
            class='unixmib text-white'
            rel='noopener noreferrer'><span class='ldmi'>POuL</span></a
          >
          e
          <a
            title='Scopri di più su unixMiB'
            href='https://unixmib.org'
            target='_blank'
            class='unixmib text-white'
            rel='noopener noreferrer'><span class='ldmi'>unixMiB</span></a
          >
        </small>
      </h4>
      <div class='subtitle'>
        <Calendar />
        {
          siteMetadata.event.date.toLocaleDateString(
            "it-IT",
            siteMetadata.event.dateOptions
          )
        }
        <br />
        <Clock /> Ore {siteMetadata.event.time}
        <br />
        <MapMarketAlt />
        {siteMetadata.contacts.place.name}
        <br />
        <ChevronRight />
        {siteMetadata.contacts.place.building}
        <br />
      </div>
      {
        !small && (
          <div class='mt-5 gx-5 d-flex flex-wrap justify-content-start clearfix'>
            <Button
              href='/#explore'
              size='lg'
              className='m-1'
              variant='warning'
            >
              Scopri di più
            </Button>
            <Button
              href={`/schedule/${params}#calendar`}
              size='lg'
              className='m-1'
              variant='warning'
            >
              {siteMetadata.switches.schedule
                ? "Guarda il programma"
                : "Programma precedente"}
            </Button>
          </div>
        )
      }
    </Container>
  </div>
</div>
