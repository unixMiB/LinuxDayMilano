---
import { getCollection } from "astro:content";
import Schedule from "../layouts/schedule";
import SchedulePrintable from "../layouts/schedule-printable";

import Layout, { HeroEnum } from "../layouts/layout.astro";

const allSchedulesYaml = await getCollection("schedules");

export function getStaticPaths() {
  return [
    { params: { path: "schedule" } },
    { params: { path: "schedule-printable" } },
  ];
}

const { path } = Astro.params;
---

<Layout id='index' hero={HeroEnum.hide}>
  {
    path === "schedule" ? (
      <Schedule client:load data={allSchedulesYaml} />
    ) : (
      <SchedulePrintable client:load data={allSchedulesYaml} />
    )
  }
</Layout>
