---
import { getCollection } from "astro:content";
import ScheduleJS from "../layouts/schedule";

import Layout, { HeroEnum } from "../layouts/layout.astro";

const allSchedulesYaml = await getCollection("schedules");
---

<Layout id='index' title='Programma' hero={HeroEnum.hide}>
  <ScheduleJS client:load allSchedules={allSchedulesYaml} />
</Layout>
