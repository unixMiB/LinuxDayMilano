---
import Footer from "../components/footer.astro";
import Header from "../components/header";

import { getCollection } from "astro:content";

import "../styles/main.scss";

import { default as data } from "../assets/siteMetadata.yml";
import Hero from "../components/hero.astro";

export enum HeroEnum {
  show,
  hide,
  small,
}

interface Props {
  description?: string;
  lang?: string;
  meta?: string;
  title?: string;
  hero?: HeroEnum;
}

const { description, lang, meta, title, hero = HeroEnum.show } = Astro.props;

const metaDescription = description || data.description;
const siteTitle = title == null ? data.title : `${title} - ${data.title}`;

const allSchedulesYaml = await getCollection("schedules");
---

<html>
  <head>
    <meta charset='UTF-8' />

    <meta name='keywords' content={data.keywords} />
    <meta name='application-name' content={data.title} />
    <meta name='author' content={data.author} />
    <meta name='description' content={metaDescription} />
    <meta name='og:title' content={siteTitle} />
    <meta name='og:description' content={metaDescription} />
    <meta name='og:type' content='website' />
    <meta name='og:locale' content='it_IT' />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:creator' content={data.author} />
    <meta name='twitter:title' content={siteTitle} />
    <meta name='twitter:description' content={metaDescription} />
  </head>

  <body>
    <div class='d-flex flex-column' style={{ minHeight: "100vh" }}>
      <header class='d-print-none'>
        <Header client:load allSchedulesYaml={allSchedulesYaml} />
      </header>
      <div class='container-fluid flex-grow-1' style={{ padding: 0 }}>
        {
          hero !== HeroEnum.hide && (
            <Hero small={hero === HeroEnum.show ? true : false} />
          )
        }

        <main id={title}>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
